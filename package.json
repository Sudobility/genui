{
  "name": "@sudobility/genui",
  "version": "0.1.121",
  "description": "Render tree driven React renderer for Kotlin-style renderable payloads",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "NODE_ENV=production tsc && NODE_ENV=production vite build",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --ignore-pattern 'dist' --ignore-pattern 'node_modules' --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test:unit": "vitest run",
    "test:run": "vitest run",
    "prepublishOnly": "NODE_ENV=production bun run build"
  },
  "keywords": [
    "react",
    "render-tree",
    "typescript",
    "ui",
    "renderer"
  ],
  "author": "John Q Huang",
  "packageManager": "bun@1.3.10",
  "peerDependencies": {
    "@sudobility/components": "^5.3.44",
    "@sudobility/design": "^1.1.66",
    "@sudobility/genui_types": "^0.0.5",
    "@vis.gl/react-google-maps": "^1.8.3",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "swiper": "^12.1.3"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@testing-library/jest-dom": "~6.10.0",
    "@testing-library/react": "~16.3.3",
    "@types/node": "~24.19.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "@vitejs/plugin-react": "~5.2.0",
    "ajv": "8",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "eslint-plugin-react-hooks": "~7.0.1",
    "eslint-plugin-react-refresh": "~0.4.26",
    "jsdom": "~26.1.0",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "typescript": "~5.9.3",
    "vite": "~7.3.7",
    "vite-plugin-dts": "~4.5.4",
    "vitest": "~3.2.4"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "license": "BUSL-1.1",
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/genui.git"
  }
}
